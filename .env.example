# Pinch test-mode credentials — https://dashboard.getpinch.com.au (Developers -> API keys)
# The marketplace runs without these; only checkout needs them.
PINCH_APP_ID=app_test_...
PINCH_SECRET=sk_test_...
PINCH_BASE=https://api.getpinch.com.au/test

# client-safe: Vite only exposes VITE_-prefixed vars to the browser
VITE_PINCH_PUBLISHABLE_KEY=pk_test_...

# signs session tokens — set this to anything long and random outside local dev
JWT_SECRET=change-me
